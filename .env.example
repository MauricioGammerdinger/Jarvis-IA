# Copie pra ".env" e preencha. O .env nunca é commitado (já no .gitignore).

# Chave que protege sua API local — invente algo aleatório.
JARVIS_API_KEY=secreta123

# Endereço do Ollama rodando na sua máquina (padrão já funciona na maioria dos casos).
OLLAMA_BASE_URL=http://localhost:11434/v1

# Quanto tempo (segundos) esperar o Ollama responder antes de desistir.
# Sem isso, uma trava no Ollama prendia o JARVIS esperando pra sempre.
OLLAMA_TIMEOUT_SECONDS=60

# Nome do modelo que você baixou no Ollama.
# gemma4 tem visão E tool-calling nativos juntos (necessário pra tool ver_tela
# funcionar de verdade) — ollama pull gemma4
# Se não precisar de visão, qwen3:8b é mais leve (só texto/tools).
JARVIS_MODEL=gemma4

# Tamanho do modelo de transcrição de áudio (tiny, base, small, medium, large-v3).
WHISPER_MODEL_SIZE=base

# Quanto tempo (segundos) esperar o modelo de busca de memória baixar, na
# primeira vez. Sem isso, uma rede lenta/bloqueada pro Hugging Face podia
# travar por até 40s antes de desistir.
EMBEDDINGS_TIMEOUT_SECONDS=10

# Opcional — só se for usar a integração com Linear.
LINEAR_API_KEY=
LINEAR_TEAM_ID=

# Opcional — só se for usar controle de lâmpada inteligente Tapo/Kasa.
# Preencha depois de configurar a lâmpada pelo app oficial (Tapo ou Kasa Smart).
TAPO_USERNAME=
TAPO_PASSWORD=
TAPO_BULB_IP=

# Configuração do listener "Hey JARVIS" (wake_word_listener.py)
JARVIS_API_URL=http://localhost:8000
WAKE_WORD_THRESHOLD=0.5
WAKE_WORD_RECORD_SECONDS=5
