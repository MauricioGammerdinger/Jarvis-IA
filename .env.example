# Copie pra ".env" e preencha. O .env nunca é commitado (já no .gitignore).

# Chave que protege sua API local — invente algo aleatório.
JARVIS_API_KEY=secreta123

# Endereço do Ollama rodando na sua máquina (padrão já funciona na maioria dos casos).
OLLAMA_BASE_URL=http://localhost:11434/v1

# Quanto tempo (segundos) esperar o Ollama responder antes de desistir.
# Sem isso, uma trava no Ollama prendia o JARVIS esperando pra sempre.
OLLAMA_TIMEOUT_SECONDS=60

# Quanto tempo manter o modelo carregado na memória entre uma pergunta e
# outra (formato: "30m", "1h", etc). O Ollama descarrega o modelo depois de
# alguns minutos sem uso por padrão — e recarregar do zero pode demorar,
# causando lentidão "só às vezes" (bem depois de um tempo sem usar).
# ⚠️ Isso só funciona de verdade se você TAMBÉM configurar a variável de
# ambiente OLLAMA_KEEP_ALIVE no Windows (veja o README) — o Ollama tem um
# bug conhecido que ignora esse valor quando mandado só por aqui.
OLLAMA_MODEL_KEEP_ALIVE=30m

# Nome do modelo que você baixou no Ollama.
# gemma4:e2b tem visão E tool-calling nativos juntos (necessário pra tool
# ver_tela funcionar de verdade) — ollama pull gemma4:e2b
# É a variante mais leve da família gemma4 — testamos e confirmamos que ela
# funciona em GPUs onde o "gemma4" puro (variante padrão, mais pesada) trava
# indefinidamente. Se sua GPU for mais forte e quiser mais qualidade, pode
# tentar "gemma4" (sem sufixo) ou "gemma4:12b", mas teste com cuidado antes
# de confiar — nem toda GPU com VRAM "suficiente" garante que funcione bem.
# Se não precisar de visão, qwen3:4b é mais leve ainda (só texto/tools).
JARVIS_MODEL=gemma4:e2b

# Tamanho do modelo de transcrição de áudio (tiny, base, small, medium, large-v3).
WHISPER_MODEL_SIZE=base

# Quanto tempo (segundos) esperar o modelo de busca de memória baixar, na
# primeira vez. Sem isso, uma rede lenta/bloqueada pro Hugging Face podia
# travar por até 40s antes de desistir.
EMBEDDINGS_TIMEOUT_SECONDS=10

# Opcional — só se for usar a integração com Linear.
LINEAR_API_KEY=
LINEAR_TEAM_ID=

# Opcional — só se for usar controle de lâmpada inteligente Tapo/Kasa.
# Preencha depois de configurar a lâmpada pelo app oficial (Tapo ou Kasa Smart).
TAPO_USERNAME=
TAPO_PASSWORD=
TAPO_BULB_IP=

# Configuração do listener "Hey JARVIS" (wake_word_listener.py)
JARVIS_API_URL=http://localhost:8000
WAKE_WORD_THRESHOLD=0.5
WAKE_WORD_RECORD_SECONDS=5

# Qual microfone usar pro "Hey JARVIS" (deixe em branco pro padrão do Windows).
# Pra ver as opções: python src\wake_word_listener.py --list-devices
# Aceita o número (ex: 2) ou um trecho do nome (ex: Headset).
WAKE_WORD_INPUT_DEVICE=

# Wake word customizada (opcional) — por padrão usa "Hey JARVIS" (já vem
# pronto, não precisa treinar nada). Se você treinar um modelo próprio
# (ex: só "JARVIS", sem o "hey"), aponte o caminho do .onnx aqui — veja o
# README, seção "Wake word customizada", pra saber como treinar.
JARVIS_WAKE_WORD_MODEL_PATH=

# Narração por voz — LIGADA por padrão. Enquanto o JARVIS trabalha numa
# tarefa com várias etapas (várias ferramentas encadeadas), ele fala em
# voz alta o que está fazendo no meio do caminho ("Consultando a
# agenda...") em vez de ficar mudo até o fim. Desligue se preferir
# silêncio até a resposta final.
JARVIS_NARRATION_ENABLED=1

# Reconhecimento de voz — só personalização (nome/tratamento), nunca
# segurança. Limiar de similaridade (0 a 1) pra considerar que reconheceu
# alguém cadastrado.
JARVIS_VOICE_MATCH_THRESHOLD=0.85


# Modo de conversa contínua: depois de responder, continua ouvindo por um
# tempo SEM precisar de "Hey JARVIS" de novo (detecta fala por energia do
# áudio). Desligue (0) se preferir sempre repetir a palavra de ativação.
JARVIS_CONVERSATION_MODE=1
JARVIS_FOLLOWUP_MAX_WAIT=8
JARVIS_TRAILING_SILENCE=1.1
JARVIS_VAD_THRESHOLD=500

# Sincronização entre PCs (opcional): aponte pra uma pasta que sincronize
# sozinha entre suas máquinas (ex: dentro do OneDrive). Compartilha Second
# Brain e compromissos. Deixe em branco se só usa o JARVIS numa máquina só.
JARVIS_SYNC_FOLDER=

# Detecção de "travado numa tarefa" — DESLIGADO por padrão (0). Se ligar (1),
# o JARVIS rastreia SÓ o título da janela em foco + tempo sem mexer o
# mouse/teclado (nunca screenshot, nunca tecla digitada, nada gravado em
# disco) e avisa se você ficar muito tempo ativamente na mesma tela.
JARVIS_FOCUS_MONITOR=0
JARVIS_STUCK_THRESHOLD_MINUTES=45
JARVIS_IDLE_THRESHOLD_MINUTES=3

# Interromper o JARVIS enquanto ele fala — DESLIGADO por padrão (0). Sem
# headset, o próprio áudio dele pode ecoar no microfone e ser confundido
# com você interrompendo — funciona bem melhor com headset. Veja o README
# antes de ligar.
JARVIS_INTERRUPT_ENABLED=0
JARVIS_INTERRUPT_THRESHOLD=1800

# Voz mais natural (Piper, ainda 100% local) em vez do espeak-ng robótico.
# Precisa baixar o modelo de voz antes — veja o README, seção "Trocando
# pra uma voz mais natural (Piper)". Deixe como "espeak" se não quiser mexer.
JARVIS_TTS_ENGINE=espeak
JARVIS_PIPER_MODEL_PATH=

# Câmera — descrição sob pedido ("o que você está vendo"). Precisa de um
# modelo com visão separado do modelo de texto (qwen3/gemma não enxergam
# imagem). Veja o README, seção "Visão por câmera".
JARVIS_CAMERA_INDEX=0
JARVIS_VISION_MODEL=

# Check-in emocional por câmera — DESLIGADO por padrão (0). Leia o README
# antes de ligar: detecção de emoção por expressão facial é conhecidamente
# imprecisa, e isso liga a câmera de tempos em tempos sozinho.
JARVIS_EMOTION_CHECK_ENABLED=0
JARVIS_EMOTION_CHECK_INTERVAL_MINUTES=30
JARVIS_EMOTION_SUSTAINED_READINGS=3

# "Conectar fatos sozinho" — limiar de similaridade (0 a 1) pra considerar
# uma conexão com o Second Brain forte o bastante pra mencionar. Não pôde
# ser calibrado com embeddings de verdade no ambiente onde foi escrito
# (rede bloqueada) — se perceber conexões fracas/forçadas, sobe o valor;
# se nunca aparecer nenhuma conexão, desce.
JARVIS_CONNECTION_THRESHOLD=0.55


